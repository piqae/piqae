# Do not make this file world-readable when it contains hosted credentials.
SPOOL_AGENT_MODE=local
SPOOL_DATA_DIR=/var/lib/spool
SPOOL_LOCAL_BIND=127.0.0.1:39100
SPOOL_EXECUTOR=process
SPOOL_EXECUTOR_PATH=/usr/libexec/spool/spool-executor-cups
SPOOL_ALLOW_PRIVATE_URI_SOURCES=false

# Hosted/self-hosted mode additionally requires:
# SPOOL_CONTROL_PLANE_URL=https://spool.example.com
# SPOOL_AGENT_ID=agt_replace_me
# SPOOL_DEVICE_KEY_FILE=/etc/spool/device.key
