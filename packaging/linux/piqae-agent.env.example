# Do not make this file world-readable when it contains hosted credentials.
PIQAE_AGENT_MODE=local
PIQAE_DATA_DIR=/var/lib/piqae
PIQAE_LOCAL_BIND=127.0.0.1:39100
PIQAE_EXECUTOR=process
PIQAE_EXECUTOR_PATH=/usr/libexec/piqae/piqae-executor-cups
PIQAE_ALLOW_PRIVATE_URI_SOURCES=false

# Hosted/self-hosted mode additionally requires:
# PIQAE_CONTROL_PLANE_URL=https://piqae.example.com
# PIQAE_AGENT_ID=agt_replace_me
# PIQAE_DEVICE_KEY_FILE=/etc/piqae/device.key
