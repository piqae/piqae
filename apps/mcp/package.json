{
  "name": "@piqae/mcp-server",
  "version": "0.1.0",
  "description": "Standards-based MCP server for operating and understanding Piqae",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "piqae-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-knowledge.mjs",
    "check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' README.md",
    "smoke:package": "node scripts/smoke-package.mjs",
    "dev": "tsx src/index.ts --stdio",
    "prepack": "pnpm --filter @piqae/sdk build && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@piqae/sdk": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "prettier": "^3.5.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
