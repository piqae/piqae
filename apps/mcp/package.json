{
  "name": "@piqae/mcp-server",
  "version": "0.1.2",
  "description": "Standards-based MCP server for operating and understanding Piqae",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piqae/piqae.git",
    "directory": "apps/mcp"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "piqae-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-knowledge.mjs",
    "check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' README.md",
    "smoke:package": "node scripts/smoke-package.mjs",
    "dev": "tsx src/index.ts --stdio",
    "prepack": "pnpm --filter @piqae/sdk build && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@piqae/sdk": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
