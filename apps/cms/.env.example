# Use a database or schema that is physically isolated from the Spool control-plane tables.
DATABASE_URL=postgres://spool_cms:change-me@127.0.0.1:5432/spool_cms
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# Optional Cloudflare R2 media storage. All values are required to enable it.
R2_BUCKET=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_MEDIA_URL=

# Publishing and price-drift integrations.
MARKETING_DEPLOY_HOOK_URL=
MARKETING_PREVIEW_URL=http://localhost:5173
CMS_PREVIEW_SECRET=
PRICING_DRIFT_CHECK_URL=
PRICING_DRIFT_WEBHOOK_URL=
PRICING_DRIFT_SHARED_SECRET=
CRON_SECRET=
