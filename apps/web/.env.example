# Hosted WorkOS AuthKit. Set all values with PIQAE_AUTH_MODE=workos.
PIQAE_AUTH_MODE=demo
# The dashboard defaults to live. Demo data requires this explicit opt-in.
PUBLIC_PIQAE_DASHBOARD_MODE=demo
PUBLIC_PIQAE_API_URL=http://localhost:8080
# Local/self-host service-key fallback only. Hosted WorkOS mode forwards the
# verified sealed-session access token and ignores this value.
PIQAE_DASHBOARD_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=

# local: no WorkOS initialization; the control plane or reverse proxy owns
# identity. demo: deterministic local viewer; never use it publicly.

# Optional server-only JSON manifest for /downloads. A supported artifact must
# include an HTTPS download URL, SHA-256, and verified platform-signing state.
# When absent, the page shows the checked-in Preview/Development support tiers
# without inventing downloadable release files.
PIQAE_RELEASE_MANIFEST_JSON=

# Public native release origin. Use credentials for the dedicated release
# bucket only; never point these at the customer print-document bucket.
# /releases/{stable|preview}/<allowlisted-file> returns a five-minute signed
# redirect while keeping the public URL stable for Sparkle and WinSparkle.
PIQAE_RELEASES_S3_ENDPOINT=
PIQAE_RELEASES_S3_ACCESS_KEY_ID=
PIQAE_RELEASES_S3_SECRET_ACCESS_KEY=
PIQAE_RELEASES_S3_BUCKET=
PIQAE_RELEASES_S3_REGION=
PIQAE_RELEASES_S3_VIRTUAL_HOSTED_STYLE=true

# Marketing launch gate. Keep false until name, support, signing, cost, and
# comparison-claim reviews have passed.
PUBLIC_MARKETING_INDEXABLE=false
# Production: https://piqae.com
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# Private Payload endpoint used at build/server time. The static fallback remains
# live if Payload is unavailable.
PAYLOAD_CMS_URL=http://localhost:3001
PAYLOAD_CMS_READ_TOKEN=
CMS_PREVIEW_SECRET=

# Optional PostHog. Analytics remains off until configured and consented.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
PUBLIC_SALES_EMAIL=

# Stripe is the transactional source of truth. Lookup keys are resolved only on
# the server; browsers submit plan slugs and intervals, never amounts.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
# Metered Price lookup keys. The matching Stripe Prices must use the
# reported_complete_live_jobs_overage meter and declare these metadata values:
# piqae_plan=pro, piqae_metric=reported_complete_live_jobs_overage,
# piqae_included_jobs=25000 for monthly or 300000 for annual,
# piqae_overage_unit=1000.
# The usage exporter records integer 1,000-job overage units.
STRIPE_PRICE_PRO_OVERAGE_MONTHLY=
STRIPE_PRICE_PRO_OVERAGE_ANNUAL=
PRICING_DRIFT_SHARED_SECRET=

# Optional Sentry error and performance monitoring. Runtime event processing
# removes users, request bodies, headers, cookies, query strings, UI/console
# breadcrumbs, and common secret fields. Keep sample rates at zero until the
# relevant environment has an approved tracing budget.
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Build-only source-map upload. SENTRY_AUTH_TOKEN is secret and must never use a
# PUBLIC_ prefix. Upload activates only when token, org, project, and the exact
# immutable release identifier are all present. Uploaded maps are deleted from
# the deploy output by the Sentry SvelteKit integration.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=
