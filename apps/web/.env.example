# Hosted WorkOS AuthKit. Set all values with SPOOL_AUTH_MODE=workos.
SPOOL_AUTH_MODE=demo
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=

# local: no WorkOS initialization; the control plane or reverse proxy owns
# identity. demo: deterministic local viewer; never use it publicly.
