# Hosted WorkOS AuthKit. Set all values with SPOOL_AUTH_MODE=workos.
SPOOL_AUTH_MODE=demo
# The dashboard defaults to live. Demo data requires this explicit opt-in.
PUBLIC_SPOOL_DASHBOARD_MODE=demo
PUBLIC_SPOOL_API_URL=http://localhost:8080
# Local/self-host service-key fallback only. Hosted WorkOS mode forwards the
# verified sealed-session access token and ignores this value.
SPOOL_DASHBOARD_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=

# local: no WorkOS initialization; the control plane or reverse proxy owns
# identity. demo: deterministic local viewer; never use it publicly.

# Optional server-only JSON manifest for /downloads. A supported artifact must
# include an HTTPS download URL, SHA-256, and verified platform-signing state.
# When absent, the page shows the checked-in Preview/Development support tiers
# without inventing downloadable release files.
SPOOL_RELEASE_MANIFEST_JSON=
