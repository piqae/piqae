{
  "name": "@piqae/shopify-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "pnpm extensions:check && react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "migrate": "node scripts/migrate-postgres.mjs",
    "check": "tsc --noEmit && pnpm extensions:check",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "node scripts/test-postgres-migrations.mjs",
    "format:check": "prettier --check .",
    "release:config": "node scripts/render-release-config.mjs",
    "extensions:check": "node scripts/check-extensions.mjs"
  },
  "dependencies": {
    "prosemirror-history": "1.5.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.11",
    "prosemirror-schema-basic": "1.2.4",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.2",
    "@piqae/sdk": "workspace:*",
    "@react-router/node": "7.12.0",
    "@react-router/serve": "7.12.0",
    "@shopify/shopify-app-react-router": "1.2.1",
    "@shopify/shopify-app-session-storage-memory": "4.0.8",
    "@shopify/shopify-app-session-storage-postgresql": "6.0.1",
    "isbot": "5.2.1",
    "pg": "8.23.0",
    "preact": "10.29.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.12.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.12.0",
    "@shopify/polaris-types": "1.0.7",
    "@types/node": "22.19.15",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "smol-toml": "1.8.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
