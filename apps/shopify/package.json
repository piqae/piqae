{
  "name": "@piqae/shopify-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "pnpm --filter @printpacket/core build && pnpm extensions:check && react-router build",
    "start": "node server.mjs",
    "migrate": "node scripts/migrate-postgres.mjs",
    "check": "pnpm --filter @printpacket/core build && tsc --noEmit && pnpm extensions:check",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "node scripts/test-postgres-migrations.mjs",
    "format:check": "prettier --check .",
    "release:config": "node scripts/render-release-config.mjs",
    "extensions:check": "node scripts/check-extensions.mjs"
  },
  "dependencies": {
    "@printpacket/core": "workspace:*",
    "prosemirror-history": "1.4.1",
    "prosemirror-commands": "1.7.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.4",
    "prosemirror-schema-basic": "1.2.4",
    "prosemirror-state": "1.4.3",
    "prosemirror-view": "1.41.3",
    "@piqae/sdk": "workspace:*",
    "@sentry/react-router": "10.69.0",
    "@react-router/express": "7.12.0",
    "@react-router/node": "7.12.0",
    "@shopify/shopify-api": "13.1.0",
    "@shopify/shopify-app-react-router": "1.2.1",
    "@shopify/shopify-app-session-storage-memory": "4.0.8",
    "@shopify/shopify-app-session-storage-postgresql": "6.0.1",
    "express": "4.21.2",
    "isbot": "5.1.32",
    "pg": "8.16.3",
    "pdfjs-dist": "6.3.289",
    "preact": "10.27.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "7.12.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.12.0",
    "@shopify/polaris-types": "1.0.7",
    "@types/node": "26.4.0",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.27.7",
    "prettier": "3.8.2",
    "smol-toml": "1.8.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
