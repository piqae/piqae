SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://example.invalid
SHOPIFY_DISTRIBUTION=app_store
SCOPES=read_orders,read_all_orders,read_draft_orders,read_products,read_customers,read_metaobjects
PIQAE_API_URL=https://api.piqae.com
# fake: loopback virtual printers only; local: self-hosted testing; live: HTTPS hosted Piqae.
PIQAE_SHOPIFY_RUNTIME=live
# Exact 40-character reviewed commit for local-source Railway deployments.
# `railway up` does not refresh repo-linked RAILWAY_GIT_COMMIT_SHA. Supply this
# as a build variable so the immutable image records the exact uploaded source.
PIQAE_RELEASE_SHA=
# Server-only Piqae platform credential used to provision one isolated child
# workspace per Shopify store. Never expose this value to Shopify Admin.
PIQAE_SHOPIFY_PLATFORM_KEY=
# 32 random bytes, base64-encoded. Store in the host secret manager.
PIQAE_SHOPIFY_CREDENTIAL_KEY=
PIQAE_SHOPIFY_DOWNLOAD_KEY=
DATABASE_URL=postgresql://user:password@localhost:5432/piqae_shopify
PIQAE_SHOPIFY_STORAGE=postgres
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_FROM_ADDRESS=
CLOUDFLARE_EMAIL_FROM_NAME=Piqae Order Printing
CLOUDFLARE_EMAIL_REPLY_TO=
SHOPIFY_APP_HANDLE=
SHOPIFY_PARTNER_API_URL=https://partners.shopify.com/ORG_ID/api/2026-07/graphql.json
SHOPIFY_PARTNER_API_TOKEN=
SHOPIFY_PARTNER_APP_ID=

# Error reporting. Sentry stays completely uninitialized while SENTRY_DSN is
# empty: no client, no transport, no events. PUBLIC_SENTRY_DSN is a separate
# opt-in for browser reporting and is the only DSN serialized into Shopify
# Admin; it is added to the document connect-src when set.
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
PUBLIC_SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
