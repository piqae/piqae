                              "path": ["title"]
                            },
                            "style": {
                              "bold": true
                            }
                          }
                        ]
                      },
                      {
                        "type": "conditional",
                        "condition": {
                          "type": "exists",
                          "value": {
                            "type": "current_path",
                            "path": ["variant", "title"]
                          }
                        },
                        "then": [
                          {
                            "type": "paragraph",
                            "content": [
                              {
                                "type": "value",
                                "value": {
