{
  "invoice": {
    "format": "printpacket/v1",
    "media": {
      "kind": "paged",
      "size": "a4",
      "orientation": "portrait",
      "margins": {
        "top_mm": 14,
        "right_mm": 14,
        "bottom_mm": 16,
        "left_mm": 14
      }
    },
    "theme": {
      "font_size_pt": 10,
      "line_height": 1.35,
      "text_color": {
        "red": 32,
        "green": 34,
        "blue": 35
      }
    },
    "resources": {},
    "header": {
      "first": [],
      "default": [],
      "last": []
    },
    "body": [
      {
        "type": "repeat",
        "items": {
          "type": "path",
          "path": ["orders"]
        },
        "gap_mm": 10,
        "children": [
          {
            "type": "grid",
            "columns": [2, 1],
            "gap_mm": 8,
            "children": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "value",
                    "value": {
                      "type": "path",
                      "path": ["shop", "name"]
                    },
                    "style": {
                      "bold": true
                    }
                  }
                ]
              },
              {
                "type": "heading",
                "level": 1,
                "content": [
                  {
                    "type": "text",
                    "value": "INVOICE"
                  }
                ]
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "value",
                "value": {
                  "type": "current_path",
                  "path": ["name"]
                },
                "style": {
                  "bold": true
                }
              }
            ]
          },
          {
            "type": "conditional",
            "condition": {
              "type": "exists",
              "value": {
                "type": "current_path",
                "path": ["shippingAddress", "formatted"]
              }
            },
            "then": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "value",
                    "value": {
                      "type": "current_path",
                      "path": ["shippingAddress", "formatted"]
                    },
                    "style": {}
                  }
                ]
              }
            ],
            "else": []
          },
          {
            "type": "divider"
          },
          {
            "type": "table",
            "items": {
              "type": "current_path",
              "path": ["lineItems"]
            },
            "repeat_header": true,
            "columns": [
              {
                "header": [
                  {
                    "type": "text",
                    "value": "Item",
                    "style": {
                      "bold": true
                    }
                  }
                ],
                "cell": [
                  {
                    "type": "value",
                    "value": {
                      "type": "current_path",
                      "path": ["title"]
                    }
                  }
                ],
                "width": 5,
                "align": "left"
              },
              {
                "header": [
                  {
                    "type": "text",
                    "value": "SKU",
                    "style": {
                      "bold": true
                    }
                  }
                ],
                "cell": [
                  {
                    "type": "value",
                    "value": {
                      "type": "current_path",
                      "path": ["sku"]
                    }
                  }
                ],
                "width": 2,
                "align": "left"
              },
              {
                "header": [
                  {
                    "type": "text",
                    "value": "Qty",
                    "style": {
                      "bold": true
                    }
                  }
                ],
                "cell": [
                  {
                    "type": "value",
                    "value": {
                      "type": "current_path",
                      "path": ["quantity"]
                    }
                  }
                ],
                "width": 1,
                "align": "right"
              },
              {
                "header": [
                  {
                    "type": "text",
                    "value": "Price",
                    "style": {
                      "bold": true
                    }
                  }
                ],
                "cell": [
                  {
                    "type": "value",
                    "value": {
                      "type": "format_money",
                      "amount": {
                        "type": "current_path",
                        "path": ["unitPrice"]
                      },
                      "currency": {
                        "type": "current_path",
                        "path": ["currency"]
                      }
                    }
                  }
                ],
                "width": 2,
                "align": "right"
              },
              {
                "header": [
                  {
                    "type": "text",
                    "value": "Total",
                    "style": {
                      "bold": true
                    }
                  }
                ],
                "cell": [
                  {
                    "type": "value",
                    "value": {
                      "type": "format_money",
                      "amount": {
                        "type": "current_path",
                        "path": ["total"]
                      },
                      "currency": {
                        "type": "current_path",
                        "path": ["currency"]
                      }
                    }
                  }
                ],
                "width": 2,
                "align": "right"
              }
            ],
            "empty": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "value": "No items"
                  }
                ]
              }
            ]
          },
          {
            "type": "divider"
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "value": "Subtotal "
              },
              {
                "type": "value",
                "value": {
                  "type": "format_money",
                  "amount": {
                    "type": "current_path",
                    "path": ["subtotal"]
                  },
                  "currency": {
                    "type": "current_path",
                    "path": ["currency"]
                  }
                }
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "value": "Tax "
              },
              {
                "type": "value",
                "value": {
                  "type": "format_money",
                  "amount": {
                    "type": "current_path",
                    "path": ["tax"]
                  },
                  "currency": {
                    "type": "current_path",
                    "path": ["currency"]
                  }
                }
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "value": "Total ",
                "style": {
                  "bold": true
                }
              },
              {
                "type": "value",
                "value": {
                  "type": "format_money",
                  "amount": {
                    "type": "current_path",
                    "path": ["total"]
                  },
                  "currency": {
                    "type": "current_path",
                    "path": ["currency"]
                  }
                },
                "style": {
                  "bold": true
                }
              }
            ]
          },
          {
            "type": "page_break"
          }
        ]
      }
    ],
    "footer": {
      "first": [],
      "default": [],
      "last": []
    }
  },
