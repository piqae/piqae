SPOOL_ENVIRONMENT=development
SPOOL_BIND=127.0.0.1:8080
SPOOL_AUTH_MODE=bootstrap
SPOOL_DATABASE_URL=postgres://spool:spool@127.0.0.1:5432/spool
SPOOL_OBJECT_STORE=s3
SPOOL_S3_ENDPOINT=http://127.0.0.1:9000
SPOOL_S3_BUCKET=spool
SPOOL_S3_REGION=auto
SPOOL_S3_ACCESS_KEY_ID=spool
SPOOL_S3_SECRET_ACCESS_KEY=replace-me
SPOOL_S3_ALLOW_HTTP=true
SPOOL_WEBHOOK_MASTER_KEY=replace-with-base64-encoded-32-byte-key
SPOOL_BOOTSTRAP_API_KEY=spl_test_replace-with-random-secret
SPOOL_BOOTSTRAP_WORKSPACE_ID=wsp_01J00000000000000000000000
SPOOL_BOOTSTRAP_ENVIRONMENT_ID=env_01J00000000000000000000001

# For hosted identity, use SPOOL_AUTH_MODE=oidc or hybrid and configure:
# SPOOL_OIDC_ISSUER=
# SPOOL_OIDC_JWKS_URL=
# SPOOL_OIDC_CLIENT_ID=
# SPOOL_OIDC_ORGANIZATION_CLAIM=org_id
# SPOOL_OIDC_PERMISSIONS_CLAIM=permissions
#
# Dashboard configuration is intentionally separate. Start with
# apps/web/.env.example.
