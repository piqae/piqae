PIQAE_ENVIRONMENT=development
PIQAE_BIND=127.0.0.1:8080
PIQAE_AUTH_MODE=bootstrap
PIQAE_DATABASE_URL=postgres://piqae:piqae@127.0.0.1:5432/piqae
PIQAE_OBJECT_STORE=s3
PIQAE_S3_ENDPOINT=http://127.0.0.1:9000
PIQAE_S3_BUCKET=piqae
PIQAE_S3_REGION=auto
PIQAE_S3_ACCESS_KEY_ID=piqae
PIQAE_S3_SECRET_ACCESS_KEY=replace-me
PIQAE_S3_ALLOW_HTTP=true
PIQAE_WEBHOOK_MASTER_KEY=replace-with-base64-encoded-32-byte-key
PIQAE_BOOTSTRAP_API_KEY=piq_test_replace-with-random-secret
PIQAE_BOOTSTRAP_WORKSPACE_ID=wsp_01J00000000000000000000000
PIQAE_BOOTSTRAP_ENVIRONMENT_ID=env_01J00000000000000000000001

# Optional control-plane OTLP traces. The binary must be built with
# `cargo build -p piqae-control-plane --features otlp`.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector.example.com/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=authorization=Bearer%20replace-me
# OTEL_SERVICE_NAME=piqae-control-plane
# OTEL_TRACES_SAMPLER=parentbased_always_on

# For hosted identity, use PIQAE_AUTH_MODE=oidc or hybrid and configure:
# PIQAE_OIDC_ISSUER=
# PIQAE_OIDC_JWKS_URL=
# PIQAE_OIDC_CLIENT_ID=
# PIQAE_OIDC_ORGANIZATION_CLAIM=org_id
# PIQAE_OIDC_PERMISSIONS_CLAIM=permissions
#
# Dashboard configuration is intentionally separate. Start with
# apps/web/.env.example.
