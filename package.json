{
  "name": "piqae",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source local and remote printing infrastructure",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm --filter @piqae/sdk build && pnpm -r check",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format:check": "pnpm -r format:check"
  },
  "engines": {
    "node": "22.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piqae/piqae.git"
  },
  "bugs": {
    "url": "https://github.com/piqae/piqae/issues"
  },
  "homepage": "https://piqae.com"
}
