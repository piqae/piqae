{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piqae.dev/schemas/release-manifest-v1.json",
  "title": "Piqae release evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "artifacts", "evidence"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "commit", "created_at"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "evidence": {
      "const": {
        "checksums": "SHA256SUMS",
        "sbom": "release-evidence.spdx.json",
        "provenance": "provenance.sigstore.json"
      }
    }
  }
}
