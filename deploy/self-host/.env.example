POSTGRES_PASSWORD=replace-with-32-random-characters
MINIO_ROOT_USER=spool
MINIO_ROOT_PASSWORD=replace-with-32-random-characters
SPOOL_WEBHOOK_MASTER_KEY=replace-with-base64-encoded-32-byte-key
SPOOL_BOOTSTRAP_API_KEY=spl_live_replace-with-random-secret
SPOOL_BOOTSTRAP_WORKSPACE_ID=wsp_01J00000000000000000000000
SPOOL_BOOTSTRAP_ENVIRONMENT_ID=env_01J00000000000000000000001
SPOOL_PORT=8080
SPOOL_WEB_PORT=3000
SPOOL_IMAGE=ghcr.io/c4coffeeco/spool/server:v1.0.0
SPOOL_WEB_IMAGE=ghcr.io/c4coffeeco/spool/web:v1.0.0
SPOOL_DASHBOARD_ORIGIN=https://dashboard.spool.example.com
SPOOL_WEB_AUTH_MODE=workos
WORKOS_CLIENT_ID=client_replace-me
WORKOS_API_KEY=sk_replace-me
WORKOS_COOKIE_PASSWORD=replace-with-32-random-characters
SPOOL_AUTH_MODE=bootstrap
# Local source builds default to the lightweight server. Official prebuilt
# server images include OTLP capability but still require an endpoint at runtime.
# SPOOL_SERVER_FEATURES=otlp
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector.example.com/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=authorization=Bearer%20replace-me
# OTEL_SERVICE_NAME=spool-control-plane
# OTEL_TRACES_SAMPLER=parentbased_always_on
# WorkOS dashboard: use hybrid so API keys and WorkOS sessions both work.
# SPOOL_AUTH_MODE=hybrid
# SPOOL_OIDC_ISSUER=https://api.workos.com/
# SPOOL_OIDC_JWKS_URL=https://api.workos.com/sso/jwks/client_replace-me
# Use SPOOL_OIDC_AUDIENCE for standard OIDC tokens, OR the claim/value binding below.
# WorkOS AuthKit uses client_id rather than aud; SPOOL_OIDC_CLIENT_ID is its shortcut.
# SPOOL_OIDC_CLIENT_ID=client_replace-me
# SPOOL_OIDC_BINDING_CLAIM=client_id
# SPOOL_OIDC_BINDING_VALUE=client_...
# SPOOL_OIDC_ORGANIZATION_CLAIM=org_id
# SPOOL_OIDC_PERMISSIONS_CLAIM=permissions
# SPOOL_OIDC_ENVIRONMENT=live
# Self-host only escape hatch; omitted means missing permissions default-deny every scope.
# SPOOL_OIDC_ALLOW_UNRESTRICTED=true
