POSTGRES_PASSWORD=replace-with-32-random-characters
MINIO_ROOT_USER=piqae
MINIO_ROOT_PASSWORD=replace-with-32-random-characters
PIQAE_WEBHOOK_MASTER_KEY=replace-with-base64-encoded-32-byte-key
PIQAE_DOCUMENT_MASTER_KEY=replace-with-a-distinct-base64-encoded-32-byte-key
PIQAE_DOCUMENT_ACTIVE_KEY_ID=document-2026-01
# On the first rotation, retain the original master key under the reserved
# legacy-v1 id until `document-key-rewrap legacy-v1` reports zero references.
# Example: {"legacy-v1":"base64-encoded-original-32-byte-key"}
PIQAE_DOCUMENT_DECRYPTION_KEYS={}
PIQAE_BOOTSTRAP_API_KEY=piq_live_replace-with-random-secret
PIQAE_BOOTSTRAP_WORKSPACE_ID=wsp_01J00000000000000000000000
PIQAE_BOOTSTRAP_ENVIRONMENT_ID=env_01J00000000000000000000001
# Local-owner browser identity is independent from the legacy API bootstrap key.
# Generate a high-entropy value, use it once with /v1/identity/local/bootstrap,
# then remove it and restart the server.
PIQAE_IDENTITY_PROVIDER=local_owner
PIQAE_LOCAL_OWNER_BOOTSTRAP_TOKEN=replace-with-32-random-characters
PIQAE_LOCAL_OWNER_SESSION_SECONDS=43200
PIQAE_PORT=8080
PIQAE_WEB_PORT=3000
PIQAE_IMAGE=ghcr.io/piqae/piqae/server:v1.0.0
PIQAE_WEB_IMAGE=ghcr.io/piqae/piqae/web:v1.0.0
PIQAE_DASHBOARD_ORIGIN=https://dashboard.piqae.example.com
PIQAE_WEB_AUTH_MODE=local
WORKOS_CLIENT_ID=client_replace-me
WORKOS_API_KEY=sk_replace-me
WORKOS_COOKIE_PASSWORD=replace-with-32-random-characters
PIQAE_AUTH_MODE=bootstrap
# Local source builds default to the lightweight server. Official prebuilt
# server images include OTLP capability but still require an endpoint at runtime.
# PIQAE_SERVER_FEATURES=otlp
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector.example.com/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=authorization=Bearer%20replace-me
# OTEL_SERVICE_NAME=piqae-control-plane
# OTEL_TRACES_SAMPLER=parentbased_always_on
# WorkOS dashboard: use hybrid so API keys and WorkOS sessions both work.
# PIQAE_AUTH_MODE=hybrid
# PIQAE_OIDC_ISSUER=https://api.workos.com/user_management/client_replace-me
# PIQAE_OIDC_JWKS_URL=https://api.workos.com/sso/jwks/client_replace-me
# Use PIQAE_OIDC_AUDIENCE for standard OIDC tokens, OR the claim/value binding below.
# WorkOS AuthKit uses client_id rather than aud; PIQAE_OIDC_CLIENT_ID is its shortcut.
# PIQAE_OIDC_CLIENT_ID=client_replace-me
# PIQAE_OIDC_BINDING_CLAIM=client_id
# PIQAE_OIDC_BINDING_VALUE=client_...
# PIQAE_OIDC_ORGANIZATION_CLAIM=org_id
# PIQAE_OIDC_PERMISSIONS_CLAIM=permissions
# PIQAE_OIDC_ENVIRONMENT=live
# Self-host only escape hatch; omitted means missing permissions default-deny every scope.
# PIQAE_OIDC_ALLOW_UNRESTRICTED=true
