# syntax=docker/dockerfile:1.7
FROM rust:1.98-bookworm AS builder
WORKDIR /source
COPY Cargo.toml Cargo.lock ./
COPY crates crates
COPY bins bins
COPY xtask xtask
COPY migrations migrations
# Published server images include OTLP and Sentry capability; both remain off at
# runtime unless standard OTEL configuration or SENTRY_DSN enables them. Local
# Compose builds override this argument with an empty value by default for the
# lightweight build.
ARG PIQAE_SERVER_FEATURES="otlp,sentry"
RUN if [ -n "${PIQAE_SERVER_FEATURES}" ]; then \
      cargo build --locked --release --bin piqae-server --features "${PIQAE_SERVER_FEATURES}"; \
    else \
      cargo build --locked --release --bin piqae-server; \
    fi

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=builder /source/target/release/piqae-server /usr/local/bin/piqae-server
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/piqae-server"]
