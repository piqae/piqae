# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS shopify-workspace-dependencies
# The slim image carries no CA bundle. Without it any TLS client in the build,
# including sentry-cli source-map upload, fails to verify certificates.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.4.0 --activate
WORKDIR /source
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY sdk/typescript/package.json sdk/typescript/package.json
COPY sdk/printpacket/package.json sdk/printpacket/package.json
COPY apps/shopify/package.json apps/shopify/package.json
RUN pnpm install --frozen-lockfile
COPY sdk/typescript sdk/typescript
COPY sdk/printpacket sdk/printpacket
RUN pnpm --filter @piqae/sdk build
RUN pnpm --filter @printpacket/core build
# Resolve the package from the Shopify workspace, not from the repository root.
# This keeps a clean container build honest about the exact workspace link that
# the application bundler will consume.
RUN pnpm --filter @piqae/shopify-app exec node --input-type=module \
    --eval "await import('@printpacket/core')"

FROM shopify-workspace-dependencies AS builder
COPY apps/shopify apps/shopify
RUN pnpm --filter @piqae/shopify-app build
RUN pnpm --filter @piqae/shopify-app --prod deploy --legacy /app
RUN cp -R apps/shopify/build /app/build
RUN cp -R apps/shopify/migrations apps/shopify/scripts /app/

FROM node:22-bookworm-slim
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
WORKDIR /app
COPY --from=builder --chown=node:node /app /app
USER node
EXPOSE 3000
CMD ["node", "node_modules/@react-router/serve/bin.js", "./build/server/index.js"]
