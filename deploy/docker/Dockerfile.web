# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS builder
# The slim image carries no CA bundle, so sentry-cli cannot verify Sentry's
# TLS and source-map upload fails without failing the build.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.4.0 --activate
WORKDIR /source
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY sdk/typescript/package.json sdk/typescript/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web apps/web
COPY sdk/typescript sdk/typescript
ENV PIQAE_DEPLOYMENT_TARGET=node
# Source-map upload credentials are consumed only by this builder stage, which
# is discarded. They are never present in the published runtime image below.
# Leaving them unset disables upload entirely rather than failing the build.
ARG SENTRY_AUTH_TOKEN=""
ARG SENTRY_ORG=""
ARG SENTRY_PROJECT=""
ARG SENTRY_RELEASE=""
# Railway does not expose RAILWAY_GIT_COMMIT_SHA as a service variable. This
# records whether it arrives as a build argument, which would let the release
# be derived per deploy rather than pinned.
ARG RAILWAY_GIT_COMMIT_SHA=""
RUN echo "railway-commit-probe:[${RAILWAY_GIT_COMMIT_SHA}]"
RUN pnpm --filter @piqae/sdk build
RUN pnpm --filter @piqae/web build:self-host
RUN pnpm --filter @piqae/web --prod deploy --legacy /app
RUN cp -R apps/web/build-node /app/build-node

FROM node:22-bookworm-slim
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
# Allow the documented 50 MiB PDF boundary plus bounded multipart framing.
# The dashboard action still enforces the exact document limit itself.
ENV BODY_SIZE_LIMIT=55M
WORKDIR /app
COPY --from=builder --chown=node:node /app /app
USER node
EXPOSE 3000
CMD ["node", "build-node/index.js"]
