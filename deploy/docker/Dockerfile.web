# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS builder
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.4.0 --activate
WORKDIR /source
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY sdk/typescript/package.json sdk/typescript/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web apps/web
COPY sdk/typescript sdk/typescript
ENV SPOOL_DEPLOYMENT_TARGET=node
RUN pnpm --filter @spool/web build:self-host
RUN pnpm --filter @spool/web --prod deploy --legacy /app
RUN cp -R apps/web/build-node /app/build-node

FROM node:22-bookworm-slim
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
WORKDIR /app
COPY --from=builder --chown=node:node /app /app
USER node
EXPOSE 3000
CMD ["node", "build-node/index.js"]
