# Spool Cloud dashboard contract. Configure these in separate Vercel Preview
# and Production environments. Values are intentionally blank or non-secret
# examples; never commit a populated copy.
SPOOL_AUTH_MODE=workos
PUBLIC_SPOOL_DASHBOARD_MODE=live
PUBLIC_SPOOL_API_URL=https://api.spool.example.com
PUBLIC_SITE_URL=https://spool.example.com

WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=https://spool.example.com/auth/callback
WORKOS_COOKIE_PASSWORD=

# The commercial contract is Free + Pro only. Free has no Stripe Price.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
# Metered recurring Prices: $0.25 per integer 1,000-job overage unit.
# Their Stripe metadata must match the catalog contract documented in
# apps/web/.env.example; monthly includes 25,000 and annual includes 300,000.
STRIPE_PRICE_PRO_OVERAGE_MONTHLY=
STRIPE_PRICE_PRO_OVERAGE_ANNUAL=
PRICING_DRIFT_SHARED_SECRET=

# Runtime DSNs may target one project or separate server/browser projects.
# The PUBLIC_ DSN is intentionally browser-readable; the upload token is not.
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Build-only source-map upload. Use the exact immutable release identifier for
# the artifact being promoted. Partial configuration fails the web build.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=

# Serve only a release manifest whose signing/notarisation fields were verified.
SPOOL_RELEASE_MANIFEST_JSON=
PUBLIC_MARKETING_INDEXABLE=false
