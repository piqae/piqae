# Piqae Cloud web-service contract. Configure separate Railway staging and
# production environments. Values are intentionally blank or non-secret
# examples; never commit a populated copy.
#
# API and worker services use the server contract documented in
# docs/operations/railway-private-preview.md. In particular, their
# PIQAE_AUTH_MODE is `oidc`, not the web service's `workos`; do not import this
# file into the API or worker service.
PIQAE_AUTH_MODE=workos
PUBLIC_PIQAE_DASHBOARD_MODE=live
PUBLIC_PIQAE_API_URL=https://api.piqae.com
PUBLIC_SITE_URL=https://piqae.com
ORIGIN=https://app.piqae.com
PIQAE_COOKIE_SECURE=true
# Required when a non-container runtime overrides the web image defaults.
BODY_SIZE_LIMIT=55M

WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=https://app.piqae.com/auth/callback
WORKOS_COOKIE_PASSWORD=

# The commercial contract is Free + Pro only. Free has no Stripe Price.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
# Metered recurring Prices: $0.25 per integer 1,000-job overage unit.
# Their Stripe metadata must match the catalog contract documented in
# apps/web/.env.example; monthly includes 25,000 and annual includes 300,000.
STRIPE_PRICE_PRO_OVERAGE_MONTHLY=
STRIPE_PRICE_PRO_OVERAGE_ANNUAL=
PRICING_DRIFT_SHARED_SECRET=

# Runtime DSNs may target one project or separate server/browser projects.
# The PUBLIC_ DSN is intentionally browser-readable; the upload token is not.
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Build-only source-map upload. Use the exact immutable release identifier for
# the artifact being promoted. Partial configuration fails the web build.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=

# Serve only a release manifest whose signing/notarisation fields were verified.
PIQAE_RELEASE_MANIFEST_JSON=

# Read-only-at-runtime release origin. Use credentials scoped to the dedicated
# piqae-releases bucket, never the print-document bucket.
PIQAE_RELEASES_S3_ENDPOINT=
PIQAE_RELEASES_S3_ACCESS_KEY_ID=
PIQAE_RELEASES_S3_SECRET_ACCESS_KEY=
PIQAE_RELEASES_S3_BUCKET=
PIQAE_RELEASES_S3_REGION=
PIQAE_RELEASES_S3_VIRTUAL_HOSTED_STYLE=false
PUBLIC_MARKETING_INDEXABLE=false
