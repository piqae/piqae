{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "piqae-edge-router",
  "main": "src/index.mjs",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "WEB_ORIGIN": "https://piqae-web-v0122-production-production.up.railway.app",
    "API_ORIGIN": "https://piqae-api-v0122-production-production.up.railway.app"
  },
  "routes": [
    {
      "pattern": "piqae.com",
      "custom_domain": true
    },
    {
      "pattern": "www.piqae.com",
      "custom_domain": true
    },
    {
      "pattern": "app.piqae.com",
      "custom_domain": true
    },
    {
      "pattern": "connect.piqae.com",
      "custom_domain": true
    },
    {
      "pattern": "docs.piqae.com",
      "custom_domain": true
    },
    {
      "pattern": "downloads.piqae.com",
      "custom_domain": true
    },
    {
      "pattern": "api.piqae.com",
      "custom_domain": true
    },
    {
      "pattern": "sync.piqae.com",
      "custom_domain": true
    }
  ]
}
