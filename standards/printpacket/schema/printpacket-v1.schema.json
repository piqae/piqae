{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:printpacket:schema:v1",
  "title": "PrintPacket v1",
  "$ref": "#/$defs/PrintPacketV1",
  "$defs": {
    "PrintPacketCapabilitiesV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "negotiation_version",
        "supported_packet_versions",
        "feature_ids",
        "conformance_profiles",
        "output_profiles",
        "deterministic",
        "limits",
        "resource_types",
        "direct_offline",
        "native_language_profiles",
        "implementation_version"
      ],
      "properties": {
        "negotiation_version": {
          "type": "integer",
          "const": 2
        },
        "supported_packet_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^printpacket/v[1-9][0-9]*$",
            "maxLength": 128
          }
        },
        "feature_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,127}$"
          }
        },
        "conformance_profiles": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._/-]{0,127}$"
          }
        },
        "output_profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/PrintPacketOutputProfile"
          }
        },
        "deterministic": {
          "type": "boolean",
          "description": "True only when the declared deterministic output profile is byte-stable."
        },
        "limits": {
          "$ref": "#/$defs/PrintPacketLimits"
        },
        "resource_types": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "direct_offline": {
          "type": "boolean",
          "description": "Diagnostic fact; it does not authorize cloud delivery or background execution."
        },
        "native_language_profiles": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/PrinterNativeLanguageProfile"
          }
        },
        "implementation_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Display-only implementation/build diagnostic; never used instead of exact capability intersection."
        }
      }
    },
    "PrintPacketLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_template_bytes",
        "max_input_bytes",
        "max_output_bytes",
        "max_pages",
        "max_resource_count",
        "max_resource_bytes",
        "max_total_resource_bytes"
      ],
      "properties": {
        "max_template_bytes": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "maximum": 52428800
        },
        "max_input_bytes": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "maximum": 52428800
        },
        "max_output_bytes": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "maximum": 524288000
        },
        "max_pages": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "maximum": 100000
        },
        "max_resource_count": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 1000
        },
        "max_resource_bytes": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "maximum": 52428800
        },
        "max_total_resource_bytes": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "maximum": 524288000
        }
      }
    },
    "PrintPacketOutputProfile": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "media_type"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._/-]{0,127}$"
            },
            "kind": {
              "const": "pdf"
            },
            "media_type": {
              "const": "application/pdf"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "media_type",
            "language_profile_id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._/-]{0,127}$"
            },
            "kind": {
              "const": "printer_native"
            },
            "media_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "language_profile_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._/-]{0,127}$"
            }
          }
        }
      ]
    },
    "PrinterNativeLanguageProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "language",
        "language_version",
        "profile_version",
        "media_type",
        "driver_fingerprint_sha256",
        "support_pack_digest_sha256",
        "printer_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]{0,127}$"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "language_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "profile_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "driver_fingerprint_sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "support_pack_digest_sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "printer_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "PrintPacketEdges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top_mm",
        "right_mm",
        "bottom_mm",
        "left_mm"
      ],
      "properties": {
        "top_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "right_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "bottom_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "left_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "PrintPacketExpression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "literal"
            },
            "value": {
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ],
          "properties": {
            "type": {
              "enum": [
                "path",
                "current_path"
              ]
            },
            "path": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 120
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "values"
          ],
          "properties": {
            "type": {
              "enum": [
                "coalesce",
                "concat"
              ]
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/PrintPacketExpression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "operator",
            "left",
            "right"
          ],
          "properties": {
            "type": {
              "const": "compare"
            },
            "operator": {
              "enum": [
                "equal",
                "not_equal",
                "less",
                "less_or_equal",
                "greater",
                "greater_or_equal"
              ]
            },
            "left": {
              "$ref": "#/$defs/PrintPacketExpression"
            },
            "right": {
              "$ref": "#/$defs/PrintPacketExpression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "operator",
            "values"
          ],
          "properties": {
            "type": {
              "const": "boolean"
            },
            "operator": {
              "enum": [
                "and",
                "or"
              ]
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/PrintPacketExpression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "not"
            },
            "value": {
              "$ref": "#/$defs/PrintPacketExpression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "exists"
            },
            "value": {
              "$ref": "#/$defs/PrintPacketExpression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "collection",
            "value"
          ],
          "properties": {
            "type": {
              "const": "contains"
            },
            "collection": {
              "$ref": "#/$defs/PrintPacketExpression"
            },
            "value": {
              "$ref": "#/$defs/PrintPacketExpression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "page_number",
                "page_count"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "operator",
            "left",
            "right"
          ],
          "properties": {
            "type": {
              "const": "arithmetic"
            },
            "operator": {
              "enum": [
                "add",
                "subtract",
                "multiply",
                "divide"
              ]
            },
            "left": {
              "$ref": "#/$defs/PrintPacketExpression"
            },
            "right": {
              "$ref": "#/$defs/PrintPacketExpression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "format_number"
            },
            "value": {
              "$ref": "#/$defs/PrintPacketExpression"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12,
              "default": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "amount",
            "currency"
          ],
          "properties": {
            "type": {
              "const": "format_money"
            },
            "amount": {
              "$ref": "#/$defs/PrintPacketExpression"
            },
            "currency": {
              "$ref": "#/$defs/PrintPacketExpression"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6,
              "default": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value",
            "format"
          ],
          "properties": {
            "type": {
              "const": "format_date"
            },
            "value": {
              "$ref": "#/$defs/PrintPacketExpression"
            },
            "format": {
              "enum": [
                "iso_date",
                "day_month_year",
                "month_day_year"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value",
            "operation"
          ],
          "properties": {
            "type": {
              "const": "format_string"
            },
            "value": {
              "$ref": "#/$defs/PrintPacketExpression"
            },
            "operation": {
              "enum": [
                "trim",
                "uppercase_ascii",
                "lowercase_ascii"
              ]
            }
          }
        }
      ]
    },
    "PrintPacketTextStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bold": {
          "type": "boolean",
          "default": false
        },
        "italic": {
          "type": "boolean",
          "default": false
        },
        "underline": {
          "type": "boolean",
          "default": false
        },
        "font_size_pt": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 4,
          "maximum": 72
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ],
          "default": "left"
        },
        "color": {
          "$ref": "#/$defs/PrintPacketColor"
        }
      }
    },
    "PrintPacketColor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "red",
        "green",
        "blue"
      ],
      "properties": {
        "red": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "green": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "blue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "PrintPacketBoxStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "padding_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "default": 0
        },
        "background": {
          "$ref": "#/$defs/PrintPacketColor"
        },
        "border_color": {
          "$ref": "#/$defs/PrintPacketColor"
        },
        "border_width_pt": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "default": 0
        }
      }
    },
    "PrintPacketTableStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cell_padding_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "default": 1
        },
        "header_background": {
          "$ref": "#/$defs/PrintPacketColor"
        },
        "header_text_color": {
          "$ref": "#/$defs/PrintPacketColor"
        },
        "border_color": {
          "$ref": "#/$defs/PrintPacketColor"
        },
        "border_width_pt": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "default": 0.25
        }
      }
    },
    "PrintPacketInline": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "value": {
              "type": "string",
              "maxLength": 100000
            },
            "style": {
              "$ref": "#/$defs/PrintPacketTextStyle"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "value"
            },
            "value": {
              "$ref": "#/$defs/PrintPacketExpression"
            },
            "style": {
              "$ref": "#/$defs/PrintPacketTextStyle"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "line_break"
            }
          }
        }
      ]
    },
    "PrintPacketNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "children"
          ],
          "properties": {
            "type": {
              "enum": [
                "section",
                "stack"
              ]
            },
            "children": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "$ref": "#/$defs/PrintPacketNode"
              }
            },
            "gap_mm": {
              "type": "number",
              "minimum": 0,
              "maximum": 2000,
              "default": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "children"
          ],
          "properties": {
            "type": {
              "const": "row"
            },
            "children": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/PrintPacketNode"
              }
            },
            "gap_mm": {
              "type": "number",
              "minimum": 0,
              "maximum": 2000,
              "default": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "children"
          ],
          "properties": {
            "type": {
              "const": "box"
            },
            "children": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "$ref": "#/$defs/PrintPacketNode"
              }
            },
            "style": {
              "$ref": "#/$defs/PrintPacketBoxStyle"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "type": {
              "const": "paragraph"
            },
            "content": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "$ref": "#/$defs/PrintPacketInline"
              }
            },
            "style": {
              "$ref": "#/$defs/PrintPacketTextStyle"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "type": {
              "const": "heading"
            },
            "content": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "$ref": "#/$defs/PrintPacketInline"
              }
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6,
              "default": 1
            },
            "style": {
              "$ref": "#/$defs/PrintPacketTextStyle"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "columns",
            "children"
          ],
          "properties": {
            "type": {
              "const": "grid"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000
              }
            },
            "children": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/PrintPacketNode"
              }
            },
            "gap_mm": {
              "type": "number",
              "minimum": 0,
              "maximum": 2000,
              "default": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "items",
            "columns"
          ],
          "properties": {
            "type": {
              "const": "table"
            },
            "items": {
              "$ref": "#/$defs/PrintPacketExpression"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/PrintPacketTableColumn"
              }
            },
            "repeat_header": {
              "type": "boolean",
              "default": false
            },
            "empty": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "$ref": "#/$defs/PrintPacketNode"
              }
            },
            "style": {
              "$ref": "#/$defs/PrintPacketTableStyle"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "items",
            "children"
          ],
          "properties": {
            "type": {
              "const": "repeat"
            },
            "items": {
              "$ref": "#/$defs/PrintPacketExpression"
            },
            "children": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "$ref": "#/$defs/PrintPacketNode"
              }
            },
            "gap_mm": {
              "type": "number",
              "minimum": 0,
              "maximum": 2000,
              "default": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "items",
            "item"
          ],
          "properties": {
            "type": {
              "const": "data_list"
            },
            "items": {
              "$ref": "#/$defs/PrintPacketExpression"
            },
            "header": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "$ref": "#/$defs/PrintPacketNode"
              }
            },
            "item": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "$ref": "#/$defs/PrintPacketNode"
              }
            },
            "empty": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "$ref": "#/$defs/PrintPacketNode"
              }
            },
            "repeat_header": {
              "type": "boolean",
              "default": true
            },
            "gap_mm": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "condition",
            "then"
          ],
          "properties": {
            "type": {
              "const": "conditional"
            },
            "condition": {
              "$ref": "#/$defs/PrintPacketExpression"
            },
            "then": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "$ref": "#/$defs/PrintPacketNode"
              }
            },
            "else": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "$ref": "#/$defs/PrintPacketNode"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "height_mm"
          ],
          "properties": {
            "type": {
              "const": "spacer"
            },
            "height_mm": {
              "type": "number",
              "minimum": 0,
              "maximum": 2000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "divider"
            },
            "width_pt": {
              "type": "number",
              "maximum": 10,
              "default": 0.5,
              "minimum": 0.1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "page_break"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "children"
          ],
          "properties": {
            "type": {
              "const": "keep_together"
            },
            "children": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "$ref": "#/$defs/PrintPacketNode"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "resource",
            "width_mm",
            "height_mm"
          ],
          "properties": {
            "type": {
              "const": "image"
            },
            "resource": {
              "type": "string",
              "maxLength": 120
            },
            "width_mm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 2000
            },
            "height_mm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 2000
            },
            "fit": {
              "enum": [
                "contain",
                "fill",
                "scale_down"
              ],
              "default": "contain"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "resource",
            "width_mm",
            "height_mm"
          ],
          "properties": {
            "type": {
              "const": "image_value"
            },
            "resource": {
              "$ref": "#/$defs/PrintPacketExpression"
            },
            "width_mm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 2000
            },
            "height_mm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 2000
            },
            "fit": {
              "enum": [
                "contain",
                "fill",
                "scale_down"
              ],
              "default": "contain"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value",
            "size_mm"
          ],
          "properties": {
            "type": {
              "const": "qr"
            },
            "value": {
              "$ref": "#/$defs/PrintPacketExpression"
            },
            "size_mm": {
              "type": "number",
              "minimum": 8,
              "maximum": 2000
            },
            "error_correction": {
              "enum": [
                "L",
                "M",
                "Q",
                "H"
              ],
              "default": "M"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value",
            "symbology",
            "width_mm",
            "height_mm"
          ],
          "properties": {
            "type": {
              "const": "barcode"
            },
            "value": {
              "$ref": "#/$defs/PrintPacketExpression"
            },
            "symbology": {
              "const": "code128"
            },
            "width_mm": {
              "type": "number",
              "minimum": 20,
              "maximum": 2000
            },
            "height_mm": {
              "type": "number",
              "minimum": 8,
              "maximum": 2000
            },
            "human_readable": {
              "type": "boolean",
              "default": false
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ],
              "default": "left"
            },
            "padding_mm": {
              "type": "number",
              "minimum": 0,
              "maximum": 50,
              "default": 0
            },
            "gap_mm": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "default": 1.4
            }
          }
        }
      ]
    },
    "PrintPacketTableColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "cell"
      ],
      "properties": {
        "header": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/PrintPacketInline"
          }
        },
        "cell": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/PrintPacketInline"
          }
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "default": 1
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ],
          "default": "left"
        }
      }
    },
    "PrintPacketRegion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/PrintPacketNode"
          }
        },
        "default": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/PrintPacketNode"
          }
        },
        "last": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/PrintPacketNode"
          }
        }
      }
    },
    "PrintPacketV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "media",
        "body"
      ],
      "properties": {
        "format": {
          "const": "printpacket/v1"
        },
        "media": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "size"
              ],
              "properties": {
                "kind": {
                  "const": "paged"
                },
                "size": {
                  "enum": [
                    "a4",
                    "a5",
                    "letter"
                  ]
                },
                "orientation": {
                  "enum": [
                    "portrait",
                    "landscape"
                  ],
                  "default": "portrait"
                },
                "margins": {
                  "$ref": "#/$defs/PrintPacketEdges"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "width_mm"
              ],
              "properties": {
                "kind": {
                  "const": "continuous"
                },
                "width_mm": {
                  "type": "number",
                  "exclusiveMinimum": 20,
                  "maximum": 500
                },
                "margins": {
                  "$ref": "#/$defs/PrintPacketEdges"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "width_mm",
                "height_mm"
              ],
              "properties": {
                "kind": {
                  "const": "label"
                },
                "width_mm": {
                  "type": "number",
                  "exclusiveMinimum": 20,
                  "maximum": 500
                },
                "height_mm": {
                  "type": "number",
                  "exclusiveMinimum": 10,
                  "maximum": 500
                },
                "margins": {
                  "$ref": "#/$defs/PrintPacketEdges"
                }
              }
            }
          ]
        },
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "font_size_pt": {
              "type": "number",
              "minimum": 4,
              "maximum": 72,
              "default": 10
            },
            "line_height": {
              "type": "number",
              "minimum": 1,
              "maximum": 3,
              "default": 1.25
            },
            "text_color": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "red",
                "green",
                "blue"
              ],
              "properties": {
                "red": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "green": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "blue": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "digest",
              "media_type",
              "byte_length"
            ],
            "properties": {
              "type": {
                "const": "image"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "media_type": {
                "const": "image/jpeg"
              },
              "byte_length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4194304
              }
            }
          }
        },
        "header": {
          "$ref": "#/$defs/PrintPacketRegion"
        },
        "body": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/PrintPacketNode"
          }
        },
        "footer": {
          "$ref": "#/$defs/PrintPacketRegion"
        }
      }
    },
    "PrintPacketTemplate": {
      "type": "object",
      "required": [
        "id",
        "name",
        "state",
        "specification",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "state": {
          "enum": [
            "draft",
            "published",
            "archived"
          ]
        },
        "specification": {
          "$ref": "#/$defs/PrintPacketV1"
        },
        "published_revision_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "PrintPacketTemplateRevision": {
      "type": "object",
      "required": [
        "id",
        "template_id",
        "revision",
        "renderer_profile",
        "specification",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "template_id": {
          "type": "string"
        },
        "specification": {
          "$ref": "#/$defs/PrintPacketV1"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "renderer_profile": {
          "type": "string",
          "const": "printpacket/v1"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "PrintPacketRender": {
      "type": "object",
      "required": [
        "id",
        "template_revision_id",
        "state",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "template_revision_id": {
          "type": "string"
        },
        "state": {
          "enum": [
            "registered",
            "rendering",
            "completed",
            "failed_terminal",
            "expiring",
            "expired"
          ]
        },
        "artifact_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_byte_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "artifact_media_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "application/pdf",
            null
          ]
        },
        "page_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100000
        },
        "failure_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "PrintPacketPrintRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "printer_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "options": {
          "$ref": "#/$defs/JobOptions"
        },
        "deliveries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 1
        },
        "render_policy": {
          "$ref": "#/$defs/PrintPacketRenderPolicy"
        },
        "render_cost": {
          "$ref": "#/$defs/PrintPacketRenderCost"
        }
      },
      "oneOf": [
        {
          "required": [
            "printer_id"
          ],
          "not": {
            "required": [
              "target_id"
            ]
          }
        },
        {
          "required": [
            "target_id"
          ],
          "not": {
            "required": [
              "printer_id"
            ]
          }
        }
      ]
    },
    "PrintPacketRenderPolicy": {
      "type": "string",
      "enum": [
        "automatic",
        "cloud_only",
        "prefer_node",
        "require_node"
      ],
      "default": "automatic",
      "description": "automatic uses bounded measured costs; cloud_only always delivers the approved PDF; prefer_node uses exact node rendering only when compatible and otherwise delivers the approved PDF; require_node fails closed when exact compatibility is unavailable."
    },
    "PrintPacketRenderCost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_count",
        "page_count",
        "pdf_bytes",
        "input_bytes"
      ],
      "properties": {
        "document_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "pdf_bytes": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "maximum": 524288000
        },
        "input_bytes": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "maximum": 52428800
        }
      }
    },
    "PrintPacketResourceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "media_type",
        "byte_length"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "media_type": {
          "type": "string",
          "enum": [
            "image/jpeg"
          ],
          "description": "Renderer ABI v1 intentionally supports resolved JPEG resources only; fonts remain built-in Base-14/Windows-1252."
        },
        "byte_length": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "maximum": 4194304
        }
      }
    },
    "PrintPacketRenderReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_policy",
        "selected_mode",
        "status",
        "reason",
        "approved_pdf_fallback",
        "destination",
        "estimates"
      ],
      "properties": {
        "requested_policy": {
          "$ref": "#/$defs/PrintPacketRenderPolicy"
        },
        "selected_mode": {
          "type": "string",
          "enum": [
            "cloud_pdf",
            "node_render"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "fallback_ready",
            "node_update_required"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 128
        },
        "approved_pdf_fallback": {
          "type": "boolean",
          "description": "True only when the immutable completed PDF may be delivered under the requested policy."
        },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported",
            "ready",
            "missing_features",
            "supported_packet_versions",
            "current_implementation",
            "missing_resources",
            "reason"
          ],
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "ready": {
              "type": "boolean"
            },
            "missing_features": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,127}$"
              }
            },
            "supported_packet_versions": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "current_implementation": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "missing_resources": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/Sha256Hex"
              }
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            }
          }
        },
        "estimates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cloud_ms",
            "node_ms"
          ],
          "properties": {
            "cloud_ms": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "node_ms": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        }
      }
    },
    "PrintPacketPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "render_id",
        "state",
        "job_id",
        "expires_at",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "render_id": {
          "type": "string"
        },
        "state": {
          "enum": [
            "awaiting_approval",
            "approving",
            "approved",
            "cancelled",
            "expired"
          ]
        },
        "job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
